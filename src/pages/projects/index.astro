---
import GoogleAnalytics from "../../components/GoogleAnalytics.astro";
import PageMeta from "../../components/PageMeta.astro";
import projects from "../../data/projects.json";

const title = "Projects | kimkim0106's HP";
const description = "kimkim0106's personal projects.";
const currentYear = new Date().getFullYear();
---

<html lang="ja">
  <head>
    <GoogleAnalytics />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1.0" />
    <title>{title}</title>
    <PageMeta title={title} description={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Color+Emoji&family=Noto+Sans+JP:wght@500;700&display=swap"
      rel="stylesheet"
    />

    <link rel="preload" href="/css/common.css" as="style" />
    <link rel="stylesheet" href="/css/common.css" type="text/css" />
    <link rel="preload" href="/css/projects.css" as="style" />
    <link rel="stylesheet" href="/css/projects.css" type="text/css" />
  </head>

  <body>
    <article>
      <p class="back-link"><a href="/">← Back to Home</a></p>
      <h1>Projects</h1>

      <ul>
        {
          projects.map((project) => (
            <li>
              <a href={`/projects/${project.slug}/`}>{project.name}</a>: {project.summary}
            </li>
          ))
        }
      </ul>
    </article>
    <footer class="copyright">
      <hr />
      &copy; 2011-{currentYear} kimkim0106
    </footer>
  </body>
</html>
