---
import GoogleAnalytics from "../../components/GoogleAnalytics.astro";
import PageMeta from "../../components/PageMeta.astro";
import projects from "../../data/projects.json";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const title = `${project.name} | kimkim0106's HP`;
const description = project.summary;
const currentYear = new Date().getFullYear();
---

<html lang="ja">
  <head>
    <GoogleAnalytics />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1.0" />
    <title>{title}</title>
    <PageMeta
      title={title}
      description={description}
      image={`/images/projects/${project.slug}.png`}
      imageAlt={project.name}
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Color+Emoji&family=Noto+Sans+JP:wght@500;700&display=swap"
      rel="stylesheet"
    />

    <link rel="preload" href="/css/common.css" as="style" />
    <link rel="stylesheet" href="/css/common.css" type="text/css" />
    <link rel="preload" href="/css/projects.css" as="style" />
    <link rel="stylesheet" href="/css/projects.css" type="text/css" />
  </head>

  <body>
    <article>
      <p class="back-link"><a href="/projects/">← Back to Projects</a></p>
      <h1>{project.name}</h1>

      <img class="project-logo" src={`/images/projects/${project.slug}.svg`} alt={`${project.name} logo`} />

      <h2>Description</h2>
      <p class="project-description">{project.description}</p>

      <h2>Videos</h2>
      <div class="project-videos">
        {
          project.videos.map((video) => (
            <figure>
              <iframe
                src={`https://www.youtube-nocookie.com/embed/${video.youtube_id}`}
                title={video.title}
                width="560"
                height="315"
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen
              ></iframe>
              <figcaption>
                <a href={`https://www.youtube.com/watch?v=${video.youtube_id}`}>{video.title}</a>
              </figcaption>
            </figure>
          ))
        }
      </div>

      <h2>Screenshots</h2>
      <div class="project-screenshots">
        {
          project.screenshots.map((screenshot) => (
            <figure>
              <img src={screenshot.src} alt={screenshot.caption} width="320" height="288" loading="lazy" />
              <figcaption>{screenshot.caption}</figcaption>
            </figure>
          ))
        }
      </div>

      <h2>Features</h2>
      <ul class="project-list">
        {project.features.map((feature) => <li>{feature}</li>)}
      </ul>

      <h2>Requirements</h2>
      <ul class="project-list">
        {
          project.requirements.map((requirement) => (
            <li>{requirement.url ? <a href={requirement.url}>{requirement.name}</a> : requirement.name}</li>
          ))
        }
      </ul>
    </article>

    <footer class="copyright">
      <hr />
      &copy; 2011-{currentYear} kimkim0106
    </footer>
  </body>
</html>
